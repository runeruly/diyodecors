---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'DiyoDecors | Premium Event Decoration Services',
  description = 'DiyoDecors - Premium Event Decoration Services. Making Moments Beautiful with elegant designs for Weddings, Birthdays, and special ceremonies.',
  ogTitle = title,
  ogDescription = description,
  canonicalPath = '',
  activePage = '',
  preloadHero = false,
  faqSchema = null,
  extraSchema = null
} = Astro.props;

const cleanCanonicalPath = canonicalPath.replace(/\.html$/, '');
const canonicalUrl = cleanCanonicalPath ? `https://diyodecors.com/${cleanCanonicalPath}` : 'https://diyodecors.com/';
const isHome = activePage === 'home';

const localBusinessSchema = extraSchema || {
  "@context": "https://schema.org",
  "@type": "EventPlanner",
  "name": "DiyoDecors",
  "image": "https://diyodecors.com/assets/images/logo.webp",
  "@id": "https://diyodecors.com",
  "url": canonicalUrl,
  "telephone": "+1-301-281-7165",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Germantown",
    "addressRegion": "MD",
    "postalCode": "20876",
    "addressCountry": "US"
  },
  "areaServed": isHome
    ? [
        "Washington DC",
        "Maryland",
        "Virginia",
        "Germantown MD",
        "Rockville MD",
        "Bethesda MD",
        "Silver Spring MD"
      ]
    : ["Washington DC", "Maryland", "Virginia", "Germantown MD", "Rockville MD"],
  ...(isHome
    ? {
        "sameAs": [
          "https://www.facebook.com/share/1BFWro3nC5/",
          "https://www.instagram.com/diyo_decors",
          "https://www.tiktok.com/@diyo.decors"
        ]
      }
    : {})
};
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://api.web3forms.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com;">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="icon" type="image/png" href="assets/images/favicon.png">
    <link rel="apple-touch-icon" href="assets/images/apple-touch-icon.png">

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="DiyoDecors">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content="https://diyodecors.com/assets/images/og-image.jpg">
    <meta property="og:url" content={canonicalUrl}>

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content="https://diyodecors.com/assets/images/og-image.jpg">

    <!-- LocalBusiness / EventPlanner Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema, null, 2)} />

    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema, null, 2)} />
    )}

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" 
          crossorigin="anonymous" 
          referrerpolicy="no-referrer">

    <!-- Google Fonts: Cinzel + Cormorant Garamond (Luxury Editorial Serif) + Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400;1,600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

    {preloadHero && (
      <link rel="preload" as="image" href="assets/images/hero/pasni_1_enhanced-wide.webp">
    )}

    <!-- Custom CSS -->
    <link rel="stylesheet" href="assets/css/styles.css?v=2.1.0">
</head>
<body>

    <div class="scroll-progress-bar" aria-hidden="true"></div>
    <a class="skip-link" href={isHome ? '#home' : '#main-content'}>Skip to main content</a>

    <Header activePage={activePage} />

    <slot />

    <Footer isHome={isHome} />

    <!-- Scripts -->
    <script is:inline src="assets/js/lenis.min.js"></script>
    <script is:inline src="assets/js/script.js?v=2.1.0"></script>
</body>

</html>
