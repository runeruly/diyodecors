---
import BaseLayout from '../layouts/BaseLayout.astro';
import LuxuryMarquee from '../components/LuxuryMarquee.astro';
import HotspotShowcase from '../components/HotspotShowcase.astro';
import { services } from '../data/services.js';
---
<BaseLayout
  title="DiyoDecors | Premium Event Decoration Services"
  description="DiyoDecors - Premium Event Decoration Services. Making Moments Beautiful with elegant designs for Weddings, Birthdays, and special ceremonies."
  ogTitle="DiyoDecors | Premium Event Decoration Services"
  ogDescription="Elevate your special occasions with luxury event decoration services in DC, MD, and VA. Inspired by the warm glow of the traditional Diyo."
  canonicalPath=""
  activePage="home"
  preloadHero={true}
>
    <!-- Hero Section -->
    <section class="hero" id="home" aria-label="DiyoDecors hero">
        <div class="hero-slider">
            <div class="hero-slide active" style="background-image: url('assets/images/hero/pasni_1_enhanced-wide.webp');"></div>
            <div class="hero-slide" data-bg="assets/images/hero/hero-wedding-wide.webp"></div>
            <div class="hero-slide" data-bg="assets/images/hero/service-gunyo-cholo-wide.webp"></div>
            <div class="hero-slide" data-bg="assets/images/hero/service-diwali-wide.webp"></div>
        </div>
        <div class="hero-overlay"></div>
        <div class="floating-diyos"></div>

        <!-- Hero Slider Controls -->
        <button class="hero-nav hero-prev" aria-label="Previous Slide"><i class="fas fa-chevron-left"></i></button>
        <button class="hero-nav hero-next" aria-label="Next Slide"><i class="fas fa-chevron-right"></i></button>
        <div class="hero-dots" role="tablist" aria-label="Hero slide navigation">
            <span class="hero-dot active" data-index="0" role="tab" aria-label="Slide 1"></span>
            <span class="hero-dot" data-index="1" role="tab" aria-label="Slide 2"></span>
            <span class="hero-dot" data-index="2" role="tab" aria-label="Slide 3"></span>
            <span class="hero-dot" data-index="3" role="tab" aria-label="Slide 4"></span>
            <span class="hero-slide-counter" aria-live="polite">01 / 04</span>
        </div>

        <div class="hero-content">
            <div class="hero-eyebrow"><span aria-hidden="true">&#10022;</span> Bespoke Event Styling &bull; DC, MD &amp; VA</div>
            <h1>Making Moments <br><span class="text-gold editorial-italic">Beautiful</span></h1>
            <p>Elevate your special occasions with our exquisite, premium decoration services. Inspired by the warm,
                sacred glow of the traditional Diyo, we bring light, elegance, and magic to every event.</p>
            <div class="hero-btns">
                <a href="#services" class="btn btn-primary">Explore Services</a>
                <a href="contact" class="btn btn-outline">Book Consultation</a>
            </div>
        </div>
    </section>

    <!-- Infinite Luxury Editorial Marquee Ribbon -->
    <LuxuryMarquee />

    <!-- Intro Teaser Section -->
    <section class="intro-teaser">
        <div class="intro-teaser-content">
            <div class="diyo-ornament" aria-hidden="true">
                <span class="ornament-line"></span>
                <i class="fas fa-fire-flame-curved"></i>
                <span class="ornament-line"></span>
            </div>
            <div class="section-header">
                <span class="editorial-pretitle dark-pretitle">Sacred Heritage Meets Modern Luxury</span>
                <h2>The <span class="text-gold editorial-italic">Diyo</span> Inspiration</h2>
            </div>
            <p>Inspired by the warm, sacred glow of the traditional Diyo, we bring purity, light, and elegance to your events. Our bespoke designs transform ordinary venues into magical spaces that create lasting memories.</p>
            
            <div class="prestige-pillars">
                <div class="prestige-pillar">
                    <div class="pillar-icon"><i class="fas fa-gem"></i></div>
                    <h4>100% Bespoke</h4>
                    <span>Custom-tailored palettes &amp; concepts</span>
                </div>
                <div class="prestige-pillar">
                    <div class="pillar-icon"><i class="fas fa-om"></i></div>
                    <h4>Cultural &amp; Modern</h4>
                    <span>Authentic heritage meets luxury</span>
                </div>
                <div class="prestige-pillar">
                    <div class="pillar-icon"><i class="fas fa-wand-magic-sparkles"></i></div>
                    <h4>Full-Service Setup</h4>
                    <span>Stress-free delivery &amp; teardown</span>
                </div>
                <div class="prestige-pillar">
                    <div class="pillar-icon"><i class="fas fa-location-dot"></i></div>
                    <h4>DMV Specialists</h4>
                    <span>Serving Washington DC, MD &amp; VA</span>
                </div>
            </div>

            <a href="about" class="btn btn-outline">Discover Our Story</a>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services" id="services">
        <div class="section-header">
            <span class="editorial-pretitle">Tailored Celebrations</span>
            <h2>Our <span class="text-gold editorial-italic">Expertise</span></h2>
            <p>From grand celebrations to intimate traditional ceremonies, we provide bespoke decoration services
                tailored to your vision.</p>
            <div class="services-filters" role="tablist" aria-label="Filter services by category">
                <button class="service-filter-btn active" data-service-filter="all" role="tab" aria-selected="true">All Services</button>
                <button class="service-filter-btn" data-service-filter="traditional" role="tab" aria-selected="false">Sacred &amp; Traditional</button>
                <button class="service-filter-btn" data-service-filter="weddings" role="tab" aria-selected="false">Weddings &amp; Milestones</button>
                <button class="service-filter-btn" data-service-filter="modern" role="tab" aria-selected="false">Modern Celebrations</button>
            </div>
            <p class="mobile-swipe-hint"><i class="fa-solid fa-hand-pointer"></i> Swipe sideways to explore our services <i class="fa-solid fa-arrow-right-long"></i></p>
        </div>

        <div class="services-carousel-wrapper">
            <button class="services-nav services-prev" aria-label="Previous Service"><i class="fas fa-chevron-left"></i></button>
            
            <div class="services-grid">
                {services.map((svc) => (
                    <div class="service-card spotlight-card" data-service-category={svc.category}>
                        <div class="service-img">
                            <img src={svc.cardImage} width={svc.cardImageWidth} height={svc.cardImageHeight} alt={`${svc.cardTitle} Decoration`} loading="lazy" decoding="async">
                        </div>
                        <div class="service-content">
                            <div class="service-icon">
                                {svc.icons.map((ic) => <i class={ic}></i>)}
                            </div>
                            <h3>{svc.cardTitle}</h3>
                            <p>{svc.cardDesc}</p>
                            <div class="service-actions">
                                <a href={svc.slug} class="service-link">Explore Details <i class="fa-solid fa-arrow-right-long"></i></a>
                                <a href={`contact?service=${svc.slug}`} class="service-inquire-btn">Inquire</a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <button class="services-nav services-next" aria-label="Next Service"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div class="services-dots"></div>
    </section>

    <!-- Featured Creations + Interactive Stage Hotspot Showcase -->
    <HotspotShowcase />

    <!-- How It Works -->
    <section class="how-it-works" id="how-it-works">
        <div class="section-header">
            <span class="editorial-pretitle">Seamless Execution</span>
            <h2>How It <span class="text-gold editorial-italic">Works</span></h2>
            <p>From your first message to the final reveal, we make creating your dream event effortless.</p>
        </div>
        <div class="how-steps">
            <div class="how-step spotlight-card reveal-up">
                <span class="how-step-num">1</span>
                <div class="how-step-icon"><i class="fa-solid fa-comments"></i></div>
                <h3>Reach Out</h3>
                <p>Send us an inquiry or message on WhatsApp with your event type, date, and vision.</p>
            </div>
            <div class="how-step spotlight-card reveal-up">
                <span class="how-step-num">2</span>
                <div class="how-step-icon"><i class="fa-solid fa-handshake"></i></div>
                <h3>Free Consultation</h3>
                <p>We discuss your theme, colors, and layout, and check availability within 24 hours.</p>
            </div>
            <div class="how-step spotlight-card reveal-up">
                <span class="how-step-num">3</span>
                <div class="how-step-icon"><i class="fa-solid fa-file-signature"></i></div>
                <h3>Custom Proposal</h3>
                <p>Receive a tailored design and quote, then lock in your date with a small deposit.</p>
            </div>
            <div class="how-step spotlight-card reveal-up">
                <span class="how-step-num">4</span>
                <div class="how-step-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                <h3>We Set Up</h3>
                <p>Our team transforms your venue on the day, so you simply enjoy every magical moment.</p>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta">
        <h2>Ready to light up your <span class="text-gold editorial-italic">event?</span></h2>
        <p>Let us bring your vision to life with our premium decoration services. Contact us today for a personalized
            consultation.</p>
        <a href="contact" class="btn btn-primary">Contact Us Now</a>
    </section>
</BaseLayout>
