---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Portfolio | DiyoDecors"
  description="DiyoDecors Portfolio - Explore our past luxury event decorations, featuring weddings, traditional Pasni and Bartabanda setups, graduations, and birthday arrangements in DC, MD, and VA."
  ogTitle="Portfolio | DiyoDecors - Event Decoration Gallery"
  ogDescription="Explore our past luxury event decorations, featuring weddings, traditional Pasni setups, graduations, and birthdays in DC, MD, and VA."
  canonicalPath="portfolio.html"
  activePage="portfolio"
>
    <!-- Page Header -->
    <div class="page-header" id="main-content">
        <div class="floating-diyos"></div>
        <h1>Our <span class="text-gold editorial-italic">Portfolio</span></h1>
    </div>

    <!-- Filterable Portfolio Grid Section -->
    <section class="portfolio-section">
        <div class="section-header">
            <span class="editorial-pretitle">Curated Showcase</span>
            <h2>Explore Our <span class="text-gold editorial-italic">Creations</span></h2>
            <p>Filter through our past event decorations across Washington DC, Maryland, and Virginia. Click any project to view full details.</p>
        </div>

        <!-- Category Filter Tabs -->
        <div class="portfolio-filters">
            <button class="filter-btn active" data-filter="all">All Projects</button>
            <button class="filter-btn" data-filter="traditional">Traditional Ceremonies</button>
            <button class="filter-btn" data-filter="graduations">Graduations</button>
            <button class="filter-btn" data-filter="weddings">Weddings &amp; Anniversaries</button>
            <button class="filter-btn" data-filter="birthdays">Birthdays &amp; Baby Showers</button>
        </div>

        <!-- Filterable Portfolio Grid -->
        <div class="portfolio-grid">
            <!-- Item 1: Pasni Stage -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Pasni Ceremony Stage" data-location="Germantown, MD" data-desc="An enhanced traditional Nepalese Pasni ceremony setup featuring a red draped shell sofa, gold sequined backdrop, and vibrant red and white drapes." data-image="assets/images/portfolio/pasni_1_enhanced.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/portfolio/pasni_1_enhanced.webp" width="1024" height="1024" alt="Pasni Ceremony Stage" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Pasni Ceremony Stage</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Germantown, MD</p>
                </div>
            </div>

            <!-- Item 2: Pasni Hall Decor -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Pasni Celebration Hall" data-location="Germantown, MD" data-desc="Elegant banquet hall configuration for Pasni celebration with red satin runners, floral arrangements, and custom lighting." data-image="assets/images/portfolio/pasni_2_enhanced.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/portfolio/pasni_2_enhanced.webp" width="800" height="800" alt="Pasni Celebration Hall" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Pasni Celebration Hall</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Germantown, MD</p>
                </div>
            </div>

            <!-- Item 3: Graduation Arch -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="graduations" data-title="Congrats Kabya Graduation Arch" data-location="Rockville, MD" data-desc="Custom organic balloon garland arch in black, white, and gold with personalized arch backdrop sign for Class of 2026." data-image="assets/images/portfolio/graduation_1_enhanced.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/portfolio/graduation_1_enhanced.webp" width="800" height="800" alt="Congrats Kabya Graduation Arch" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Graduations</span>
                    <h3>Graduation Backdrop Arch</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Rockville, MD</p>
                </div>
            </div>

            <!-- Item 4: Graduation Table Setting -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="graduations" data-title="Graduation Table Details" data-location="Rockville, MD" data-desc="Intricate table setting details featuring glossy dark wood tables, crystal glassware, custom favor boxes, and signature Diyo cards." data-image="assets/images/portfolio/graduation_2_enhanced.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/portfolio/graduation_2_enhanced.webp" width="800" height="800" alt="Graduation Table Details" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Graduations</span>
                    <h3>Graduation Table Details</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Rockville, MD</p>
                </div>
            </div>

            <!-- Item 5: Luxury Wedding Mandap -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="weddings" data-title="Luxury Wedding Mandap" data-location="Bethesda, MD" data-desc="Breathtaking wedding mandap with royal gold accents, lush floral arrangements, and warm ambient lighting." data-image="assets/images/hero-wedding.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/hero-wedding.webp" width="1024" height="1024" alt="Luxury Wedding Mandap" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Weddings</span>
                    <h3>Luxury Wedding Mandap</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Bethesda, MD</p>
                </div>
            </div>

            <!-- Item 6: Bartabanda Ceremony Setup -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Bartabanda Ceremony Setup" data-location="Gaithersburg, MD" data-desc="Authentic sacred thread ceremony setup incorporating traditional brass vessels, fresh marigold garlands, and ritual seating." data-image="assets/images/service-bartabanda.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-bartabanda.webp" width="800" height="800" alt="Bartabanda Ceremony Setup" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Bartabanda Sacred Setup</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Gaithersburg, MD</p>
                </div>
            </div>

            <!-- Item 7: Gunyo Cholo Celebration -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Gunyo Cholo Backdrop" data-location="Silver Spring, MD" data-desc="Vibrant red, green, and gold coming-of-age ceremony backdrop with cultural motifs and elegant seating." data-image="assets/images/service-gunyo-cholo.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-gunyo-cholo.webp" width="1024" height="1024" alt="Gunyo Cholo Backdrop" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Gunyo Cholo Backdrop</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Silver Spring, MD</p>
                </div>
            </div>

            <!-- Item 8: Birthday Party Backdrop -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="birthdays" data-title="Vibrant Birthday Backdrop" data-location="Fairfax, VA" data-desc="Creative theme decoration with organic balloon sculptures, personalized backdrop signage, and cake table display." data-image="assets/images/service-birthday.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-birthday.webp" width="800" height="800" alt="Vibrant Birthday Backdrop" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Birthdays</span>
                    <h3>Vibrant Birthday Backdrop</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Fairfax, VA</p>
                </div>
            </div>

            <!-- Item 9: Baby Shower Celebration -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="birthdays" data-title="Soft Pastel Baby Shower" data-location="Tysons, VA" data-desc="Soft, elegant pastel arch and floral setup to welcome the new arrival in style." data-image="assets/images/service-babyshower.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-babyshower.webp" width="800" height="800" alt="Soft Pastel Baby Shower" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Birthdays</span>
                    <h3>Pastel Baby Shower Setup</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Tysons, VA</p>
                </div>
            </div>

            <!-- Item 10: Milestone Anniversary Gala -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="weddings" data-title="Milestone Anniversary Setup" data-location="Washington, DC" data-desc="Sophisticated decor with crystal accents, deep burgundy drapes, and warm candle illumination." data-image="assets/images/service-anniversaries.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-anniversaries.webp" width="800" height="800" alt="Milestone Anniversary Setup" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Weddings</span>
                    <h3>Milestone Anniversary Setup</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Washington, DC</p>
                </div>
            </div>

            <!-- Item 11: Diwali Festival Setup -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Diwali Light Festival Setup" data-location="Germantown, MD" data-desc="Radiant festival decor featuring handcrafted diyos, floral rangoli patterns, and warm ambient string lights." data-image="assets/images/service-diwali.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-diwali.webp" width="1024" height="1024" alt="Diwali Light Festival Setup" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Diwali Festival Setup</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Germantown, MD</p>
                </div>
            </div>

            <!-- Item 12: Special Puja Mandap -->
            <div class="portfolio-card spotlight-card" tabindex="0" role="button" aria-haspopup="dialog" data-category="traditional" data-title="Spiritual Puja Altar" data-location="Frederick, MD" data-desc="Serene and peaceful traditional altar with yellow marigolds, brass kalash items, and sacred drapery." data-image="assets/images/service-pujas.webp">
                <div class="portfolio-img-wrap">
                    <img src="assets/images/service-pujas.webp" width="800" height="800" alt="Spiritual Puja Altar" loading="lazy">
                    <div class="portfolio-overlay">
                        <span class="portfolio-zoom-icon"><i class="fas fa-search-plus"></i></span>
                    </div>
                </div>
                <div class="portfolio-card-info">
                    <span class="portfolio-tag">Traditional</span>
                    <h3>Spiritual Puja Altar</h3>
                    <p class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Frederick, MD</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Full-Screen Modal Lightbox -->
    <div id="portfolioLightbox" class="portfolio-lightbox" role="dialog" aria-modal="true" aria-label="Portfolio project details">
        <div class="lightbox-overlay"></div>
        <div class="lightbox-content">
            <button class="lightbox-close" aria-label="Close Lightbox"><i class="fas fa-times"></i></button>
            <button class="lightbox-nav lightbox-prev" aria-label="Previous Project"><i class="fas fa-chevron-left"></i></button>
            <button class="lightbox-nav lightbox-next" aria-label="Next Project"><i class="fas fa-chevron-right"></i></button>
            <div class="lightbox-body">
                <div class="lightbox-img-container">
                    <img id="lightboxImage" src="" alt="Portfolio Image">
                </div>
                <div class="lightbox-details">
                    <span id="lightboxTag" class="portfolio-tag">Category</span>
                    <h2 id="lightboxTitle">Project Title</h2>
                    <p id="lightboxLocation" class="portfolio-loc"><i class="fas fa-map-marker-alt text-gold"></i> Location</p>
                    <p id="lightboxDesc">Description</p>
                    <a href="contact.html" id="lightboxBookBtn" class="btn btn-primary">Book Similar Setup</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <section class="cta">
        <h2>Ready to light up your <span class="text-gold editorial-italic">event?</span></h2>
        <p>Let us bring your vision to life with our premium decoration services. Contact us today for a personalized
            consultation.</p>
        <a href="contact.html" class="btn btn-primary">Contact Us Now</a>
    </section>
</BaseLayout>
