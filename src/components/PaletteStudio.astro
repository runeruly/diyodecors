---
import { palettes } from '../data/palettes.js';
---
<section class="palette-studio" id="palette-studio">
    <div class="section-header">
        <span class="editorial-pretitle">Interactive Design Atelier</span>
        <h2>Curate Your <span class="text-gold editorial-italic">Signature Palette</span></h2>
        <p>Select a color story below to preview how we harmonize drapery, florals, and lighting—then carry your palette directly into your consultation.</p>
    </div>

    <!-- Palette Selector Tabs -->
    <div class="palette-tabs" role="tablist" aria-label="Choose a signature color palette">
        {palettes.map((palette, index) => (
            <button
                class={`palette-tab-btn${index === 0 ? ' active' : ''}`}
                data-palette-id={palette.id}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                type="button"
            >
                <span class="palette-tab-dots" aria-hidden="true">
                    {palette.swatches.slice(0, 3).map((s) => (
                        <span class="mini-swatch" style={`background-color: ${s.hex};`}></span>
                    ))}
                </span>
                <span class="palette-tab-label">{palette.name}</span>
            </button>
        ))}
    </div>

    <!-- Palette Interactive Stage Panels -->
    <div class="palette-stage-container">
        {palettes.map((palette, index) => (
            <div
                class={`palette-panel${index === 0 ? ' active' : ''}`}
                data-palette-panel={palette.id}
                role="tabpanel"
            >
                <div class="palette-visual">
                    <img src={palette.image} width="900" height="900" alt={palette.name} loading="lazy">
                    <div class="palette-swatches-bar">
                        {palette.swatches.map((swatch) => (
                            <div class="swatch-chip">
                                <span class="swatch-circle" style={`background-color: ${swatch.hex};`}></span>
                                <div class="swatch-meta">
                                    <strong>{swatch.name}</strong>
                                    <span>{swatch.hex}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="palette-info spotlight-card">
                    <span class="palette-tagline">{palette.tagline}</span>
                    <h3>{palette.name}</h3>
                    <p class="palette-desc">{palette.description}</p>

                    <div class="palette-meta-block">
                        <h4>Signature Elements in This Look</h4>
                        <ul class="palette-elements-list">
                            {palette.elements.map((el) => (
                                <li><i class="fas fa-check text-gold"></i> <span>{el}</span></li>
                            ))}
                        </ul>
                    </div>

                    <div class="palette-meta-block">
                        <h4>Most Requested For</h4>
                        <div class="palette-ceremony-tags">
                            {palette.idealFor.map((tag) => (
                                <span class="ceremony-pill">{tag}</span>
                            ))}
                        </div>
                    </div>

                    <div class="palette-cta-row">
                        <a
                            href={`contact.html?service=${palette.serviceSlug}&palette=${encodeURIComponent(palette.name)}`}
                            class="btn btn-primary"
                        >
                            Request This Palette <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
                        </a>
                        <a href="portfolio.html" class="btn btn-outline">View Gallery</a>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>
